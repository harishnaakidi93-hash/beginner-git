# Authentication settings
# Use a unique username and a strong password.
AUTH_USERNAME=restaurant_admin
AUTH_PASSWORD=replace-with-a-long-unique-password

# Generate a unique value for production deployments.
# Use: openssl rand -hex 32
FLASK_SECRET_KEY=replace-with-a-32-byte-random-secret

# Optional settings
PORT=5000
CORS_ORIGINS=http://localhost:5173
SESSION_TIMEOUT_HOURS=8
