# Authentication settings
# Use a unique administrator email and a strong password.
AUTH_USERNAME=restaurant_admin@example.com
AUTH_PASSWORD=replace-with-a-long-unique-password

# Generate a unique value for production deployments.
# Use: openssl rand -hex 32
FLASK_SECRET_KEY=replace-with-a-32-byte-random-secret

# Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth credentials
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Password reset email settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=restaurant@your-domain.com
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Optional settings
PORT=5000
CORS_ORIGINS=http://localhost:5173
SESSION_TIMEOUT_HOURS=8
